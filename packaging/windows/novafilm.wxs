<?xml version="1.0" encoding="utf-8"?>
<!--
  NovaFilm MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build novafilm.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files and a Start Menu shortcut. No file associations.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="NovaFilm"
      Manufacturer="Nova Foods"
      Version="$(var.Version)"
      UpgradeCode="6AD26212-A1D7-57B4-979E-2693092F6728"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="NovaFilm video editor" Manufacturer="Nova Foods" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of NovaFilm is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="NovafilmIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NovafilmIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://workflowind.agcunae.com/apps/novafilm" />
    <Property Id="ARPURLUPDATEINFO" Value="https://workflowind.agcunae.com/apps/novafilm" />
    <Property Id="ARPHELPLINK" Value="https://workflowind.agcunae.com/inbox" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NovaFilm" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="NovaFilm" Level="1">
      <ComponentGroupRef Id="NovafilmFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="NovafilmFiles" Directory="INSTALLFOLDER">
      <Component Id="NovafilmApp" Guid="9395EED1-DBF6-530B-91F2-480802AE9F9B">
        <File Id="NovafilmExe" Source="$(var.BinDir)\novafilm.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="NovaFilm"
              Description="NovaFilm video editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NovafilmIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\novafilm.exe" Value="[#NovafilmExe]" Type="string" />
      </Component>

      <Component Id="NovafilmCli">
        <File Id="NovafilmCliExe" Source="$(var.BinDir)\novafilm-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="NovaFoodsLegalNotice">
        <File Id="NovaFoodsLegalNoticeFile" Source="$(sys.SOURCEFILEDIR)..\..\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
